[Unit]
Description=JottiCP DNS Proxy Daemon (PowerDNS REST API wrapper)
After=network.target pdns.service
Wants=pdns.service

[Service]
Type=simple
User=jotticp
Group=jotticp
WorkingDirectory=/opt/jotticp
ExecStart=/opt/jotticp/bin/jotti-dns
Restart=always
RestartSec=5
StartLimitBurst=3
StartLimitIntervalSec=60
EnvironmentFile=/etc/jotticp/dns.env
LimitNOFILE=16384
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jotti-dns

# Graceful shutdown
TimeoutStopSec=15
KillMode=mixed
KillSignal=SIGTERM

# Security hardening
# orbit-dns only needs network access to talk to PowerDNS REST API
# and make outbound UDP DNS queries for propagation checks
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/jotticp
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
SystemCallFilter=@system-service @network-io
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
