[Unit]
Description=OrbitCP Cron Scheduler Daemon (SSL renewal, backups, DNSBL, metrics)
After=network.target postgresql.service valkey.service
Wants=postgresql.service valkey.service

[Service]
Type=simple
User=orbitcp
Group=orbitcp
WorkingDirectory=/opt/orbitcp
ExecStart=/opt/orbitcp/bin/orbit-cron
Restart=always
RestartSec=10
StartLimitBurst=3
StartLimitIntervalSec=120
EnvironmentFile=/etc/orbitcp/cron.env
LimitNOFILE=16384
StandardOutput=journal
StandardError=journal
SyslogIdentifier=orbit-cron

# Graceful shutdown — allow tasks to finish their current iteration
TimeoutStopSec=60
KillMode=mixed
KillSignal=SIGTERM

# Security hardening
# orbit-cron only performs DB queries, Valkey pushes, and gRPC calls.
# It does not write to the filesystem or run system commands.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/orbitcp
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
SystemCallFilter=@system-service @network-io
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
