[Unit]
Description=JottiCP Mail Management Daemon (Postfix + Dovecot + rspamd)
After=network.target postfix.service dovecot.service rspamd.service
Wants=postfix.service dovecot.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/jottiecp
ExecStart=/opt/jottiecp/bin/jotti-mail
Restart=always
RestartSec=5
StartLimitBurst=3
StartLimitIntervalSec=60
EnvironmentFile=/etc/jottiecp/mail.env
LimitNOFILE=16384
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jotti-mail

# Graceful shutdown
TimeoutStopSec=15
KillMode=mixed
KillSignal=SIGTERM

# orbit-mail requires root to:
# - Write Postfix config files (owned by root)
# - Run postmap, postfix reload, doveadm pw
# - Create Maildir structures under /var/mail/vhosts/
# - Write Dovecot users file (owned by root/dovecot)
# - Run maildirmake.dovecot
# - Write Sieve scripts
# - Run rspamadm dkim_keygen
NoNewPrivileges=false
PrivateTmp=false
ProtectSystem=false
ReadWritePaths=/etc/postfix /etc/dovecot /var/mail /etc/rspamd
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_CHOWN CAP_SETUID CAP_SETGID
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ProtectKernelTunables=true
ProtectKernelModules=true

[Install]
WantedBy=multi-user.target
