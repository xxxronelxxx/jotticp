[Unit]
Description=JottiCP Panel API Server
After=network.target postgresql.service valkey.service
Wants=postgresql.service valkey.service

[Service]
Type=simple
User=jotticp
Group=jotticp
WorkingDirectory=/opt/jotticp
ExecStart=/opt/jotticp/bin/jotti-panel
Restart=always
RestartSec=5
StartLimitBurst=3
StartLimitIntervalSec=60
EnvironmentFile=/etc/jotticp/panel.env
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jotti-panel

# Graceful shutdown — allow 30s for in-flight requests to drain
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/log/jotticp /var/lib/jotticp /etc/jotticp
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
