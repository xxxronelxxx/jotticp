; JottiCP PHP-FPM pool for {{domain}}
; Generated by jotti-agent — DO NOT EDIT MANUALLY
; Template version: 1.0.0
; Re-generated on every PHP version switch or quota change.

[{{unix_user}}]
; ── Process identity ─────────────────────────────────────────────────────────
user  = {{unix_user}}
group = {{unix_user}}

; ── Listen socket ────────────────────────────────────────────────────────────
; Unix socket with tight permissions — www-data (nginx/OLS) is the only reader.
listen            = /run/php/php{{php_version}}-fpm-{{unix_user}}.sock
listen.owner      = www-data
listen.group      = www-data
listen.mode       = 0660
listen.backlog    = 128

; ── Process manager ──────────────────────────────────────────────────────────
; ondemand: spawn workers on demand, recycle after idle timeout.
; Suitable for multi-tenant hosting where many sites are low-traffic.
; Adjust to dynamic/static for high-traffic dedicated sites.
pm                        = ondemand
pm.max_children           = {{pm_max_children}}
pm.process_idle_timeout   = 30s
pm.max_requests           = 500
pm.status_path            = /php-fpm-status-{{unix_user}}
ping.path                 = /php-fpm-ping-{{unix_user}}
ping.response             = pong

; ── Working directory ────────────────────────────────────────────────────────
chdir = /home/{{unix_user}}

; ── Logging ──────────────────────────────────────────────────────────────────
access.log             = /var/log/php/{{unix_user}}-access.log
access.format          = "%R - %u %t \"%m %r%Q%q\" %s %f %{mili}d %{kilo}M %C%%"
slowlog                = /var/log/php/{{unix_user}}-slow.log
request_slowlog_timeout = 5s
request_terminate_timeout = 60s

; ── Security: per-site PHP hardening ─────────────────────────────────────────
; open_basedir: confine filesystem access to site homedir + system PHP share.
; Temp paths are site-specific to prevent /tmp cross-contamination.
php_admin_value[open_basedir]      = /home/{{unix_user}}:/tmp/{{unix_user}}:/usr/share/php:/usr/share/pear
php_admin_value[disable_functions] = exec,passthru,shell_exec,system,proc_open,popen,proc_get_status,dl,ini_set,putenv,apache_setenv,pcntl_exec,pcntl_fork,pcntl_signal,pcntl_waitpid,pcntl_wexitstatus
php_admin_flag[expose_php]         = off
php_admin_flag[allow_url_fopen]    = off
php_admin_flag[allow_url_include]  = off

; ── Error logging ────────────────────────────────────────────────────────────
php_admin_flag[log_errors]                  = on
php_admin_flag[display_errors]              = off
php_admin_flag[display_startup_errors]      = off
php_admin_value[error_log]                  = /var/log/php/{{unix_user}}-error.log
php_admin_value[error_reporting]            = E_ALL & ~E_DEPRECATED & ~E_STRICT

; ── Session isolation ────────────────────────────────────────────────────────
php_admin_value[session.save_handler]  = files
php_admin_value[session.save_path]     = /var/lib/php/sessions/{{unix_user}}
php_admin_value[session.cookie_httponly] = 1
php_admin_value[session.cookie_secure]   = 1
php_admin_value[session.cookie_samesite] = Lax
php_admin_value[session.gc_probability] = 1
php_admin_value[session.gc_divisor]    = 100

; ── Upload temp dir ──────────────────────────────────────────────────────────
php_admin_value[upload_tmp_dir] = /tmp/{{unix_user}}

; ── OPcache (PHP 8.1+ with JIT) ──────────────────────────────────────────────
; opcache.jit is set per-pool to allow disabling JIT for legacy code.
; Valid values: "off", "tracing" (recommended), "function"
php_admin_value[opcache.enable]                = 1
php_admin_value[opcache.enable_cli]            = 0
php_admin_value[opcache.memory_consumption]    = 128
php_admin_value[opcache.interned_strings_buffer] = 16
php_admin_value[opcache.max_accelerated_files] = 10000
php_admin_value[opcache.revalidate_freq]       = 60
php_admin_value[opcache.validate_timestamps]   = 1
php_admin_value[opcache.save_comments]         = 1
php_admin_value[opcache.fast_shutdown]         = 1
php_admin_value[opcache.jit_buffer_size]       = 32M
php_admin_value[opcache.jit]                   = {{opcache_jit}}

; ── Resource limits ──────────────────────────────────────────────────────────
php_admin_value[memory_limit]        = {{memory_limit}}
php_admin_value[max_execution_time]  = 60
php_admin_value[max_input_time]      = 60
php_admin_value[max_input_vars]      = 5000
php_admin_value[upload_max_filesize] = 64M
php_admin_value[post_max_size]       = 64M
php_admin_value[output_buffering]    = 4096

; ── Environment variables passed to PHP workers ──────────────────────────────
env[HOSTNAME]      = $HOSTNAME
env[PATH]          = /usr/local/bin:/usr/bin:/bin
env[TMP]           = /tmp/{{unix_user}}
env[TMPDIR]        = /tmp/{{unix_user}}
env[TEMP]          = /tmp/{{unix_user}}
env[JOTTICP_SITE]  = {{domain}}
