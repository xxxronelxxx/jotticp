# JottiCP nginx vhost for {{domain}}
# Generated by jotti-agent — DO NOT EDIT MANUALLY
# Template version: 1.0.0
# Re-generated on: SSL status change, suspension toggle, quota change.

# ── Upstream PHP-FPM ─────────────────────────────────────────────────────────
upstream php_{{unix_user}} {
    server unix:/run/php/php{{php_version}}-fpm-{{unix_user}}.sock;
    keepalive 4;
}

# ── HTTP (port 80) ───────────────────────────────────────────────────────────
server {
    listen      80;
    listen      [::]:80;
    server_name {{domain}} www.{{domain}};

    # Access / error logs with site-specific prefix
    access_log /var/log/nginx/{{unix_user}}.access.log combined buffer=16k flush=5s;
    error_log  /var/log/nginx/{{unix_user}}.error.log  warn;

    # ACME HTTP-01 challenge directory — always served even during redirect.
    # jotti-agent writes challenge tokens here; path must not be proxied.
    location ^~ /.well-known/acme-challenge/ {
        root         /var/lib/jotticp/acme/{{domain}};
        default_type text/plain;
        try_files    $uri =404;
    }

    {{#if ssl_active}}
    # SSL is active — redirect all other traffic to HTTPS.
    location / {
        return 301 https://$host$request_uri;
    }
    {{else}}
    # SSL not yet provisioned — serve site directly over HTTP.
    root  /home/{{unix_user}}/public_html;
    index index.php index.html index.htm;

    include /etc/nginx/snippets/orbit-php-{{unix_user}}.conf;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }
    {{/if}}
}

{{#if ssl_active}}
# ── HTTPS (port 443) ─────────────────────────────────────────────────────────
server {
    listen      443 ssl;
    listen      [::]:443 ssl;
    http2       on;
    server_name {{domain}} www.{{domain}};

    # ── TLS configuration ────────────────────────────────────────────────────
    ssl_certificate     /etc/jotticp/ssl/{{domain}}/fullchain.pem;
    ssl_certificate_key /etc/jotticp/ssl/{{domain}}/key.pem;

    # Session resumption — shared cache so all workers benefit
    ssl_session_cache   shared:SSL_{{unix_user}}:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Protocol and cipher hardening (Mozilla Intermediate profile)
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

    # OCSP stapling — reduces TLS handshake latency
    ssl_stapling        on;
    ssl_stapling_verify on;
    resolver            1.1.1.1 8.8.8.8 valid=300s;
    resolver_timeout    5s;

    # ── Security headers ─────────────────────────────────────────────────────
    # HSTS: 6 months. Extend to 31536000 + preload once site is stable.
    add_header Strict-Transport-Security "max-age=15768000; includeSubDomains" always;
    add_header X-Content-Type-Options     "nosniff"                             always;
    add_header X-Frame-Options            "SAMEORIGIN"                          always;
    add_header Referrer-Policy            "strict-origin-when-cross-origin"     always;
    add_header Permissions-Policy         "geolocation=(), camera=(), microphone=()" always;

    # ── ACME challenge (reachable on 443 too for completeness) ───────────────
    location ^~ /.well-known/acme-challenge/ {
        root         /var/lib/jotticp/acme/{{domain}};
        default_type text/plain;
        try_files    $uri =404;
    }

    {{#if suspended}}
    # ── SITE SUSPENDED ───────────────────────────────────────────────────────
    return 503;
    error_page 503 @suspended;
    location @suspended {
        root          /usr/share/jotticp/suspended;
        try_files     /index.html =503;
        default_type  text/html;
        add_header    Retry-After 3600 always;
    }
    {{else}}
    # ── Normal site serving ──────────────────────────────────────────────────
    root  /home/{{unix_user}}/public_html;
    index index.php index.html index.htm;

    # Core PHP-FPM location block (fastcgi params, timeouts, buffers)
    include /etc/nginx/snippets/orbit-php-{{unix_user}}.conf;

    # Front-controller pattern (Laravel, WordPress, Symfony, etc.)
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # Static asset caching — 1-year immutable for fingerprinted assets
    location ~* \.(css|js|woff2?|ttf|otf|eot|svg|ico|webp|png|jpg|jpeg|gif|avif)$ {
        expires    1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        access_log off;
        try_files  $uri =404;
    }

    # Deny access to dotfiles (.env, .git, .htaccess, etc.)
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    # Deny direct access to PHP backup files
    location ~ ~$ {
        deny all;
        access_log off;
    }
    {{/if}}

    # ── Logging ──────────────────────────────────────────────────────────────
    access_log /var/log/nginx/{{unix_user}}.access.log combined buffer=16k flush=5s;
    error_log  /var/log/nginx/{{unix_user}}.error.log  warn;
}
{{/if}}
