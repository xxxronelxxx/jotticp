# OrbitCP — Environment Variables
# Copy this to .env and fill in your values
# Generate JWT_SECRET: openssl rand -base64 48

DATABASE_URL=postgresql://orbitcp:CHANGE_ME@127.0.0.1:5432/orbitcp
VALKEY_URL=redis://127.0.0.1:6379
JWT_SECRET=GENERATE_WITH_openssl_rand_-base64_48
ORBIT_LISTEN=127.0.0.1:2087
ORBIT_LOG_LEVEL=info
ORBIT_APPS_DIR=/opt/orbitcp/apps
ORBIT_BACKUPS_DIR=/opt/orbitcp/backups
ORBIT_PLAN=community
PDNS_API_URL=http://127.0.0.1:8053
PDNS_API_KEY=CHANGE_ME
